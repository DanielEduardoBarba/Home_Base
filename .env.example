# Optional: override JWT signing secret (otherwise auto-created in .runtime/jwt_secret)
# HOMEBASE_JWT_SECRET=

# Required for Cursor chat (local agents — same billing as IDE)
# https://cursor.com/dashboard → API & SSH Keys → User API Keys
CURSOR_API_KEY=

# Bind address (0.0.0.0 for VPN / LAN access)
HOMEBASE_HOST=0.0.0.0
# Optional: force the IP Expo/Metro + project APIs advertise to phones (defaults to
# WireGuard/tunnel iface, then first private LAN IP). Use when hostname -I picks Wi‑Fi.
# HOMEBASE_ADVERTISE_HOST=10.0.0.1
# Dev API port hint (./build.sh --run always uses :8081 + Vite :3081 so it can
# run beside production :8888). Systemd forces HOMEBASE_PORT=8888 in prod.
HOMEBASE_PORT=8081

# Default model when the Cursor tab has no selection (UI can override per message).
# Use "auto" to let Cursor pick (recommended); or a specific id from Cursor.models.list.
CURSOR_MODEL=auto

# View tab (remote screen). Unit defaults to :0 + /home/daniel/.Xauthority;
# override here if needed (synced to /var/lib/homebased/.env on deploy).
HOMEBASE_DISPLAY=:0
HOMEBASE_XAUTHORITY=/home/daniel/.Xauthority
# Optional: force seat UID for View helper (default = owner of /tmp/.X11-unix/X0)
# HOMEBASE_VIEW_UID=1000
