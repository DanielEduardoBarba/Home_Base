# Optional: override JWT signing secret (otherwise auto-created in .runtime/jwt_secret)
# HOMEBASE_JWT_SECRET=

# Bind address (0.0.0.0 for VPN / LAN access)
HOMEBASE_HOST=0.0.0.0

# Listen port for production (./build.sh --deploy / homebased). Change this and redeploy.
# Dev `./build.sh --run` always uses :8081 + Next :3081 so it can sit beside prod.
HOMEBASE_PORT=8080

# Optional: force the IP Expo/Metro + project APIs advertise to phones
# (default: native 192.168.x LAN, not WireGuard)
# HOMEBASE_ADVERTISE_HOST=192.168.0.201

# Default model when Chat has no selection (UI can override per message).
CURSOR_MODEL=auto

# View tab (remote screen) — Linux / X11 only. Set to your seat user's display.
# HOMEBASE_DISPLAY=:0
# HOMEBASE_XAUTHORITY=/home/YOU/.Xauthority
# HOMEBASE_VIEW_UID=1000
