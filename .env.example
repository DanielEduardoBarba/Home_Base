# Required: shared secret for REST + WebSocket access
HOMEBASE_TOKEN=change-me-to-a-long-random-string

# Required for Cursor chat (local agents — same billing as IDE)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Bind address (0.0.0.0 for VPN / LAN access)
HOMEBASE_HOST=0.0.0.0
# Dev API port (Vite on 3080 proxies /api + /ws here). Production systemd forces :80.
HOMEBASE_PORT=8080

# Optional model for local agents
CURSOR_MODEL=composer-2.5
