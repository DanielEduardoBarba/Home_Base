# Secrets & local config (never commit)
.env
config/projects.json
# Personal presets (committed: example.json + homebase.json)
config/presets/*
!config/presets/example.json
!config/presets/homebase.json

# Runtime
.runtime/
*.log

# Incidental local Python (hooks / one-liners — not the API server)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend / Bun
web/node_modules/
server/node_modules/
web/dist/
web/out/
web/.next/

# Packaged binary (copied to /usr/share on --deploy)
dist/
dist.oldroot/
*.bin

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
*.code-workspace
