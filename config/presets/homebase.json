{
  "id": "homebase",
  "name": "Home Base",
  "stateDir": ".runtime",
  "ports": [
    {
      "id": "api",
      "label": "API",
      "port": 8080,
      "health": "/api/health"
    }
  ],
  "actions": [
    {
      "id": "deploy",
      "label": "Deploy self",
      "script": "./build.sh",
      "args": ["--deploy"],
      "kind": "ship",
      "group": "ship",
      "hint": "Build + safe install + restart service"
    },
    {
      "id": "bin_only",
      "label": "Build binary",
      "script": "./build.sh",
      "args": ["--bin"],
      "kind": "ship",
      "group": "ship",
      "hint": "Bun compile — ./build.sh --bin"
    },
    {
      "id": "run_dev",
      "label": "Dev server",
      "script": "./build.sh",
      "args": ["--run"],
      "kind": "run",
      "group": "main",
      "variant": "primary"
    },
    {
      "id": "stop",
      "label": "Stop",
      "type": "stop",
      "variant": "danger",
      "group": "main"
    },
    {
      "id": "selfqa",
      "label": "Self-QA",
      "script": "./build.sh",
      "args": ["--selfqa"],
      "kind": "selfqa",
      "group": "qa",
      "hint": "Cyclic Dev+QA sprint via Cursor agent CLI (model auto)"
    }
  ]
}
