{
  "id": "unity",
  "name": "Unity",
  "stateDir": ".unity",
  "ports": [
    {
      "id": "webgl",
      "label": "WebGL",
      "port": 8410
    },
    {
      "id": "mcp-bridge",
      "label": "MCP Bridge",
      "port": 6400
    }
  ],
  "actions": [
    {
      "id": "editor",
      "label": "Editor + MCP bridge",
      "script": "scripts/unity/start-editor-bridge.sh",
      "args": [],
      "kind": "run",
      "variant": "primary",
      "group": "main",
      "hint": "Headless Unity with Coplay MCP bridge on :6400"
    },
    {
      "id": "webgl_build",
      "label": "WebGL build",
      "script": "scripts/unity/build-webgl.sh",
      "args": [],
      "kind": "run",
      "group": "main",
      "hint": "Batchmode WebGL → Builds/WebGL (stops this project's bridge first if live-webgl calls it)"
    },
    {
      "id": "webgl",
      "label": "WebGL live view",
      "script": "scripts/unity/live-webgl.sh",
      "args": ["8410"],
      "kind": "run",
      "group": "main",
      "hint": "Watch Assets → rebuild → serve on VPN/wg0:<webgl-port> (or HB_WEBGL_BIND / 127.0.0.1) with reload"
    },
    {
      "id": "stop",
      "label": "Stop bridge",
      "script": "scripts/unity/stop-editor-bridge.sh",
      "args": [],
      "kind": "run",
      "variant": "danger",
      "group": "main"
    }
  ]
}
