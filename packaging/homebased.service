[Unit]
Description=Home Base control plane (homebased)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/homebased
WorkingDirectory=/var/lib/homebased
Environment=HOMEBASE_HOME=/var/lib/homebased
Environment=HOMEBASE_HOST=0.0.0.0
EnvironmentFile=-/var/lib/homebased/.env
# Force production port after EnvironmentFile so a copied dev .env cannot override it
Environment=HOMEBASE_PORT=8888
Restart=on-failure
RestartSec=3
# Allow PTY shells and child process trees for managed projects
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
