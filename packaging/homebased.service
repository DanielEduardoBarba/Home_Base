[Unit]
Description=Home Base control plane (homebased)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/usr/share/homebased/hb-vpn-access.sh --apply
ExecStart=/usr/bin/homebase
WorkingDirectory=/var/lib/homebased
Environment=HOMEBASE_HOME=/var/lib/homebased
Environment=HOMEBASE_SHARE=/usr/share/homebased
Environment=HOMEBASE_HOST=0.0.0.0
Environment=CURSOR_SDK_BRIDGE_BIN=/usr/share/homebased/cursor-sdk-bridge/bin/cursor-sdk-bridge
# View tab: X11 session for screen capture / input (root → user display)
Environment=HOMEBASE_DISPLAY=:0
Environment=HOMEBASE_XAUTHORITY=/home/daniel/.Xauthority
EnvironmentFile=-/var/lib/homebased/.env
# Force production port after EnvironmentFile so a copied dev .env cannot override it
Environment=HOMEBASE_PORT=8888
Restart=on-failure
RestartSec=3
# Allow PTY shells and child process trees for managed projects
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
