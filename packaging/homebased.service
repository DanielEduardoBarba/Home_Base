[Unit]
Description=Home Base control plane (homebased)
After=network-online.target
Wants=network-online.target
# Crash loops stop after 8 tries in 2 minutes. `systemctl stop` still stays down.
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/usr/share/homebased/hb-vpn-access.sh --apply
ExecStart=/usr/bin/homebase
WorkingDirectory=/var/lib/homebased
Environment=HOMEBASE_HOME=/var/lib/homebased
Environment=HOMEBASE_SHARE=/usr/share/homebased
Environment=HOMEBASE_HOST=0.0.0.0
# Defaults for View (X11). Overridden by EnvironmentFile when set.
Environment=HOMEBASE_DISPLAY=:0
# Port and View paths: set in /var/lib/homebased/.env (HOMEBASE_PORT default 8080)
EnvironmentFile=-/var/lib/homebased/.env
# Any process exit (crash, fatal signal, or exit 0) comes back.
# An explicit `systemctl stop` stays stopped so deploys can swap the binary.
Restart=always
RestartSec=3
OOMPolicy=kill
# Allow PTY shells and child process trees for managed projects
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
